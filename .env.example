# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Postgres Configuration (Server-Side Only)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Service Role Key (secret): used by Next.js route handler to bypass RLS.
# NEVER expose this key to client-side code (never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789abcdef"

# Where notification emails should be sent (Jasmanjot's personal address)
CONTACT_TO_EMAIL="jasmanjotsinghsarna@gmail.com"

# The sender identity.
# For initial testing before domain verification, you can use Resend's free sandbox sender:
# "Portfolio Contact <onboarding@resend.dev>" (can send only to your own Resend account email).
# Once you verify a custom domain in Resend, change this to:
# "Jasmanjot Sarna <contact@jasmanjotsarna.dev>"
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 3. Security & Rate Limiting
# ------------------------------------------------------------------------------
# Random secret salt used to hash visitor IP addresses with SHA-256 before storage
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
IP_HASH_SALT="generate_a_random_32_byte_hex_string_here"

# ------------------------------------------------------------------------------
# 4. Optional: Upstash Redis (For Global Serverless Rate Limiting)
# If provided, the route handler will use Upstash Redis for sliding-window rate limiting.
# If omitted, the handler falls back to an automatic Postgres/database-level rate limit
# (max 5 submissions per hashed IP per hour).
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
